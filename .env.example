# Supabase — MAD Studio project ONLY (Brain, campaigns, inventory, auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_NAME="MAD STUDIO"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API server public links (optional; falls back to REPLIT_DOMAINS or NEXT_PUBLIC_SITE_URL)
# APP_PUBLIC_ORIGIN=https://your-production-domain

# AI Provider & Model Cascade (format: provider:model_id or model_id)
# Primary model attempted first — must support generateContent
AI_PRIMARY_MODEL="gemini-2.5-flash"
# Comma-separated fallbacks if primary fails or hits high demand (503/429)
# Avoid retired IDs like gemini-1.5-pro / gemini-1.5-flash (not found on v1beta)
AI_FALLBACK_MODELS="gemini-2.0-flash,gemini-2.0-flash-lite,gemini-3.5-flash,gemini-3.8-flash"

# Provider Keys (set once — duplicate keys later in the file overwrite earlier values)
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Jina Reader (Brain Lab live sync)
# JINA_AI_API_KEY=
# JINA_AI_READER_ENDPOINT=https://r.jina.ai/

# Cost metering (never hardcode rates in application code)
# NZD conversion multiplier applied to calculated USD token costs
CURRENCY_USD_TO_NZD_RATE=1.65
# Fallback per-million rates when model is missing from ai_model_pricing
AI_DEFAULT_INPUT_COST_PER_MILLION_USD=0.10
AI_DEFAULT_OUTPUT_COST_PER_MILLION_USD=0.40

# Website → Inventory sync webhook (Authorization: Bearer <secret> or x-sync-secret)
SYNC_WEBHOOK_SECRET=replace-with-long-random-secret

# Cron jobs (Authorization: Bearer <secret> or x-cron-secret)
# Used by /api/cron/sync-metrics and /api/cron/dispatch-scheduled (every minute)
CRON_SECRET=replace-with-long-random-secret

# Meta Graph API (Instagram / Facebook publishing)
# META_GRAPH_API_VERSION=v21.0
# Fallback when social_connections row is missing (Worn Label Society)
# META_ACCESS_TOKEN=
# WLS_INSTAGRAM_ACCOUNT_ID=
# WLS_FACEBOOK_PAGE_ID=

# VIP Email (Resend) — otherwise email posts to outbound webhook
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=MAD Studio <onboarding@resend.dev>
# VIP_EMAIL_TEST_LIST=you@example.com,vip@example.com

# Optional absolute JSON catalog for fashion / website intake only
# (never applied to food / FÜDI tenants — use the FÜDI vars below instead)
# INVENTORY_FEED_URL=https://www.wornlabelsociety.co.nz/api/public/marketplace/listings
# Per-brand override example:
# INVENTORY_FEED_URL_WORN_LABEL_SOCIETY=https://www.wornlabelsociety.co.nz/api/public/marketplace/listings
# External FÜDI app Supabase — READ-ONLY feed pull (never use for NEXT_PUBLIC_SUPABASE_URL)
# FUDI_SUPABASE_URL=https://your-fudi-project.supabase.co
# FUDI_SUPABASE_ANON_KEY=
# FUDI_SUPABASE_SERVICE_ROLE_KEY=  # optional; prefer anon unless RLS blocks reads
# FUDI_SUPABASE_USE_SERVICE_ROLE_FOR_READ=false
# FUDI_SUPABASE_PULL_LIMIT=20
# FUDI_FEED_WEBHOOK_SECRET=replace-with-long-random-secret

# FÜDI / food eatery feed (JSON posts, specials, or menu items)
# INVENTORY_FEED_URL_FUDI=https://join.fudi.nz/api/public/feed
# FUDI_FEED_URL=https://join.fudi.nz/api/public/feed
# INVENTORY_FOOD_FEED_URL=
# When set, Refresh Feed uses the app JSON URL first; Instagram is not used as fallback
# INVENTORY_FOOD_FEED_SKIP_INSTAGRAM=true
# Relative path appended to entities.website_url (and www variant) when absolute feed is unset
# INVENTORY_NEW_ARRIVALS_PATH=/api/public/marketplace/listings
# Dev-only fallback sample item when live catalog is unreachable
# INVENTORY_USE_DEMO_FEED=false
